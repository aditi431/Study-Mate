# Environment: development or production
ENVIRONMENT=development

# Required in production. Generate a strong random value.
JWT_SECRET=studymate-local-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Leave as SQLite for local development. Use a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./studymate.db

# Comma-separated exact origins for the frontend.
CORS_ORIGINS=http://localhost:5173
