# Supabase project values: Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Needed only when the project still signs JWTs with HS256; never expose this in the frontend.
SUPABASE_JWT_SECRET=

# Use a direct PostgreSQL connection or a session-mode pooler connection.
# Require SSL, for example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Comma-separated exact origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# Reserved for the future document retrieval/AI implementation.
LLM_API_KEY=
EMBEDDING_API_KEY=
