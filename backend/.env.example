# Required. Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

APP_NAME=StudyMate API
# MySQL example: mysql+pymysql://user:password@localhost:3306/studymate
DATABASE_URL=mysql+pymysql://studymate_user:replace-me@localhost:3306/studymate

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional. The current AI prototype does not call Gemini.
GEMINI_API_KEY=replace-if-a-Gemini-integration-is-added

AI_DAILY_LIMIT_PER_USER=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_REQUEST_TIMEOUT_SECONDS=10

DEMO_MODE=false
DEMO_EMAIL=demo@studymate.local
DEMO_PASSWORD=replace-with-a-unique-demo-password
DEMO_AI_DAILY_LIMIT_PER_USER=3
